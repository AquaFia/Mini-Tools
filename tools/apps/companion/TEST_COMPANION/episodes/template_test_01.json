          "nextNode": "template_ending_a",
          "requires": "None"
        }
      ],
      "nextNode": "template_ending_a"
    },
    "template_ending_a": {
      "type": "Ending",
      "expression": "active",
      "dialogue": "Ending A reached. Replay the episode to test the newly unlocked route.",
      "endingId": "template_ending_a",
      "unlocks": [
        "path_a_complete"
      ]
    },
    "template_ending_b": {
      "type": "Ending",
      "expression": "warning",
      "dialogue": "Ending B reached. Requirement and replay behavior both worked.",
      "endingId": "template_ending_b",
      "unlocks": [
        "path_b_complete"
      ]
    }
  },
  "achievement": {
    "id": "template_test_all_endings",
    "identity": "probe",
    "title": "TEMPLATE TEST // COMPLETE",
    "description": "Reached both test endings.",
    "requiredEndings": [
      "template_ending_a",
      "template_ending_b"
    ]
